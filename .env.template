# Copy this to .env and fill in your credentials
# .env is in .gitignore so it won't be committed

# ──────────────────────────────────────────────────────────────
# POLYMARKET CREDENTIALS (required for --exchange polymarket)
# ──────────────────────────────────────────────────────────────
POLYMARKET_API_KEY=your_api_key_here
POLYMARKET_SECRET=your_secret_here
POLYMARKET_PASSPHRASE=your_passphrase_here
POLYMARKET_PRIVATE_KEY=your_private_key_hex_here

# ──────────────────────────────────────────────────────────────
# KALSHI CREDENTIALS (required for --exchange kalshi)
# ──────────────────────────────────────────────────────────────
# 1. Create a Kalshi API key from the production dashboard
# 2. Download the private key file and store it in a non-tracked local folder
# 3. Copy the API key ID shown in the dashboard
# 4. Keep the private key file out of Git and point the path below at your local secrets folder
KALSHI_API_KEY_ID=your_kalshi_key_id_here
KALSHI_PRIVATE_KEY_PATH=./secrets/kalshi-api.key
KALSHI_BASE_URL=https://api.elections.kalshi.com

# Demo Kalshi URL (optional):
# KALSHI_BASE_URL=https://demo-api.kalshi.co

# ──────────────────────────────────────────────────────────────
# OPTIONAL: Logging and runtime configuration
# ──────────────────────────────────────────────────────────────
LOG_DIR=./logs
TRADING_MODE=OBSERVE

# ──────────────────────────────────────────────────────────────
# RESEARCH LAB DATA PROVIDERS (required for daily research loop)
# ──────────────────────────────────────────────────────────────
# FRED (macro series): https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here
# SEC EDGAR requires a descriptive UA with contact email, else live fetches are blocked
SEC_EDGAR_USER_AGENT=Your Name your_email@example.com

# ──────────────────────────────────────────────────────────────
# RESEARCH REPORT EMAIL DELIVERY (reused by run_daily_research.py)
# For Gmail: create an App Password (not your login password) and use it below.
# ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=your_gmail_address@gmail.com
SMTP_PASSWORD=your_gmail_app_password_here
PORTFOLIO_REPORT_EMAIL_FROM=your_gmail_address@gmail.com
PORTFOLIO_REPORT_EMAIL_TO=judgepadraig@gmail.com

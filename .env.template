# Copy this to .env and fill in your credentials
# .env is in .gitignore so it won't be committed

# ──────────────────────────────────────────────────────────────
# POLYMARKET CREDENTIALS (required for --exchange polymarket)
# ──────────────────────────────────────────────────────────────
POLYMARKET_API_KEY=your_api_key_here
POLYMARKET_SECRET=your_secret_here
POLYMARKET_PASSPHRASE=your_passphrase_here
POLYMARKET_PRIVATE_KEY=your_private_key_hex_here

# ──────────────────────────────────────────────────────────────
# KALSHI CREDENTIALS (required for --exchange kalshi)
# ──────────────────────────────────────────────────────────────
# 1. Create account at kalshi.com
# 2. Generate RSA keypair locally into a non-tracked folder:
#      mkdir -p secrets
#      openssl genrsa -out secrets/kalshi-private-key.pem 4096
#      openssl rsa -in secrets/kalshi-private-key.pem -pubout -out secrets/kalshi-public-key.pem
# 3. Upload the public key to Kalshi dashboard and copy the API key ID
# 4. Keep PEM files out of Git and point the path below at your local secrets folder
KALSHI_API_KEY_ID=your_kalshi_key_id_here
KALSHI_PRIVATE_KEY_PATH=./secrets/kalshi-private-key.pem
KALSHI_BASE_URL=https://api.elections.kalshi.com

# Demo Kalshi URL (optional):
# KALSHI_BASE_URL=https://demo-api.kalshi.co

# ──────────────────────────────────────────────────────────────
# OPTIONAL: Logging and runtime configuration
# ──────────────────────────────────────────────────────────────
LOG_DIR=./logs
TRADING_MODE=OBSERVE

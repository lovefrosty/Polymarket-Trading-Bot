[Unit]
Description=Polymarket V1 Trader
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/Users/padraigjudge/Desktop/Polymarket Bot
Environment=TRADING_MODE=OBSERVE
Environment=RUNTIME_DB_PATH=/Users/padraigjudge/Desktop/Polymarket Bot/runtime.db
ExecStart=/Users/padraigjudge/Desktop/Polymarket Bot/.venv/bin/python3 -m scripts.run_system --mode ${TRADING_MODE} --db-path ${RUNTIME_DB_PATH}
Restart=always
RestartSec=5
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
